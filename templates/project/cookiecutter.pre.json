{
    "cloud_provider": [
        "aws"
    ],
    "use_api": "y",
    "use_db": "y",
    "use_storage": "y",
    "api_domain": "jwnwilson.co.uk",
    "use_db_logic": [
        "sql",
        "nosql"
    ],
    "__conditions__": {
        "use_db_logic": "{{ cookiecutter.use_db != 'n' }}",
        "api_domain": "{{ cookiecutter.use_api != 'n' }}"
    },
    "__prompts__": {
        "use_api": "Do you want fastapi?",
        "use_db": "Do you want a database?",
        "use_storage": "Do you want to store files?",
        "use_db_logic": {
            "__prompt__": "Select the db storage method",
            "sql": "Add Sqlalchemy to project",
            "nosql": "Add NoSQL wrapper to project"
        },
        "api_domain": "Enter your api domain (This should be registered already):"
    }
}