{
    "cloud_provider": [
        "aws",
        "azure",
        "gcp"
    ],
    "use_db": "y",
    "use_db_logic": [
        "sql",
        "nosql"
    ],
    "use_storage": "y",
    "__conditions__": {
        "use_db_logic": "{{ cookiecutter.use_db != 'n' }}"
    },
    "__prompts__": {
        "use_db": "Do you want to use a database?",
        "use_storage": "Do you want to use a storage service?",
        "use_db_logic": {
            "__prompt__": "Select the db storage method",
            "sql": "Add Sqlalchemy to project",
            "nosql": "Add NoSQL wrapper to project"
        }
    }
}