{
    "project_name": "Name of the project",
    "project_slug": "{{ cookiecutter.project_name.lower().replace(' ', '-') }}",
    "project_short_description": "A short description of the project",
    "full_name": "Your name",
    "email": "Your address email (you@example.com)",
    "version": "0.0.0",
    "cloud_provider": [
        "aws",
        "azure",
        "gcp"
    ],
    "use_db": true,
    "use_storage": true,
    "__conditions__": {
        "enable_storage": "{{ cookiecutter.use_db != 'n' }}"
    },
    "__prompts__": {
        "enable_storage": {
            "__prompt__": "Select the db storage method",
            "db_sql": "Add Sqlalchemy",
            "nosql": "Add NoSQL wrapper"
        }
    }
}